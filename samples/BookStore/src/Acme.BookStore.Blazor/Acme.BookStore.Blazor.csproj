    <PackageReference Include="Volo.Abp.FeatureManagement.Blazor.Server" Version="9.3.2" />
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" Version="9.3.2" />
    <PackageReference Include="Volo.Abp.Identity.Blazor.Server" Version="9.3.2" />
    <PackageReference Include="Volo.Abp.TenantManagement.Blazor.Server" Version="9.3.2" /> -->
