<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <MvcRazorExcludeRefAssembliesFromPublish>false</MvcRazorExcludeRefAssembliesFromPublish>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.5" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <!-- <PackageReference Include="Blazorise.Bootstrap5" Version="1.8.1" />
    <PackageReference Include="Blazorise.Icons.FontAwesome" Version="1.8.1" /> -->
    <PackageReference Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\modules\Account\Rm.Abp.Account.Web.OpenIddict\Rm.Abp.Account.Web.OpenIddict.csproj" />
    <ProjectReference Include="..\..\..\..\modules\BasicTheme\Rm.Abp.AspNetCore.Mvc.UI.Theme.Basic\Rm.Abp.AspNetCore.Mvc.UI.Theme.Basic.csproj" />
    <ProjectReference Include="..\..\..\..\modules\BootstrapBlazorTheme\Rm.Abp.AspnetCore.Components.Server.BootstrapBlazorTheme\Rm.Abp.AspnetCore.Components.Server.BootstrapBlazorTheme.csproj" />
    <ProjectReference Include="..\..\..\..\modules\FeatureManagement\Rm.Abp.FeatureManagement.Blazor.Server.BootstrapBlazorUI\Rm.Abp.FeatureManagement.Blazor.Server.BootstrapBlazorUI.csproj" />
    <ProjectReference Include="..\..\..\..\modules\IdentityManagement\Rm.Abp.IdentityManagement.Blazor.Server.BootstrapBlazorUI\Rm.Abp.IdentityManagement.Blazor.Server.BootstrapBlazorUI.csproj" />
    <ProjectReference Include="..\..\..\..\modules\SettingManagement\Rm.Abp.SettingManagement.Blazor.Server.BootstrapBlazorUI\Rm.Abp.SettingManagement.Blazor.Server.BootstrapBlazorUI.csproj" />
    <ProjectReference Include="..\..\..\..\modules\TenantManagement\Rm.Abp.TenantManagement.Blazor.Server.BootstrapBlazorUI\Rm.Abp.TenantManagement.Blazor.Server.BootstrapBlazorUI.csproj" />
    <ProjectReference Include="..\Acme.BookStore.Application\Acme.BookStore.Application.csproj" />
